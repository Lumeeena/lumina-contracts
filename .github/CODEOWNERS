# Paths that can run code on a contributor's machine or in CI. A pull request
# touching any of these requires an explicit approval from an owner listed
# here, regardless of who opened it.

# Editor and container config can run tasks automatically when a folder opens.
/.vscode/        @DeborahOlaboye
/.devcontainer/  @DeborahOlaboye

# Package manifests: `preinstall` / `postinstall` hooks execute on `npm install`.
package.json     @DeborahOlaboye
**/package.json  @DeborahOlaboye

# This is a Rust workspace; it has no legitimate need for web assets or build
# output.
/public/         @DeborahOlaboye
/dist/           @DeborahOlaboye

# Changes here decide which files reviewers and tooling see.
/.gitignore      @DeborahOlaboye

# CI can execute arbitrary code on every push.
/.github/        @DeborahOlaboye
