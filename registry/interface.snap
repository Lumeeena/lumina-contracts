error RegistryError { AlreadyInitialized = 1, Unauthorized = 2, AlreadyRegistered = 3, ContractNotFound = 4, InvalidMetadata = 5, NotOwner = 6, NotInitialized = 7, ProposalNotFound = 8, ThresholdNotMet = 9, TimelockNotElapsed = 10, AlreadyApproved = 11, NotAdmin = 12, InvalidThreshold = 13, AlreadyExecuted = 14, StakingNotConfigured = 15, InvalidAmount = 16, InsufficientStake = 17, StakeLocked = 18, RegistrationActive = 19, NoCategories = 20 }
fn approve_proposal(admin: Address, proposal_id: U32) -> Result<(), RegistryError>
fn deactivate(caller: Address, contract_id: Address) -> Result<(), RegistryError>
fn execute_proposal(proposal_id: U32) -> Result<(), RegistryError>
fn get_active_contracts(offset: U32, limit: U32) -> Vec<ContractEntry>
fn get_active_contracts_by_category(category: Category, offset: U32, limit: U32) -> Vec<ContractEntry>
fn get_active_profiles(offset: U32, limit: U32) -> Vec<ContractProfile>
fn get_admin() -> Result<Address, RegistryError>
fn get_admins() -> Result<Vec<Address>, RegistryError>
fn get_categories(contract_id: Address) -> Vec<Category>
fn get_contract(contract_id: Address) -> Result<ContractEntry, RegistryError>
fn get_contract_count() -> U32
fn get_contract_profile(contract_id: Address) -> Result<ContractProfile, RegistryError>
fn get_contracts_by_owner(owner: Address, offset: U32, limit: U32) -> Vec<ContractEntry>
fn get_proposal(proposal_id: U32) -> Result<Proposal, RegistryError>
fn get_reputation(contract_id: Address) -> Reputation
fn get_slashes(contract_id: Address) -> Vec<SlashRecord>
fn get_stake(contract_id: Address) -> I128
fn get_staking_config() -> Result<(Address, Address), RegistryError>
fn get_threshold() -> Result<U32, RegistryError>
fn get_version() -> U32
fn initialize(admins: Vec<Address>, threshold: U32) -> Result<(), RegistryError>
fn is_registered(contract_id: Address) -> Bool
fn is_verified(contract_id: Address) -> Bool
fn propose_add_admin(proposer: Address, new_admin: Address) -> Result<U32, RegistryError>
fn propose_change_threshold(proposer: Address, new_threshold: U32) -> Result<U32, RegistryError>
fn propose_configure_staking(proposer: Address, token: Address, treasury: Address) -> Result<U32, RegistryError>
fn propose_deactivate(proposer: Address, contract_id: Address) -> Result<U32, RegistryError>
fn propose_remove_admin(proposer: Address, admin_to_remove: Address) -> Result<U32, RegistryError>
fn propose_set_verified(proposer: Address, contract_id: Address, verified: Bool) -> Result<U32, RegistryError>
fn propose_slash(proposer: Address, contract_id: Address, amount: I128, reason: String) -> Result<U32, RegistryError>
fn propose_upgrade(proposer: Address, new_wasm_hash: BytesN<32>) -> Result<U32, RegistryError>
fn register_contract(owner: Address, contract_id: Address, name: String, description: String, categories: Vec<Category>) -> Result<(), RegistryError>
fn set_categories(owner: Address, contract_id: Address, categories: Vec<Category>) -> Result<(), RegistryError>
fn stake(owner: Address, contract_id: Address, amount: I128) -> Result<(), RegistryError>
fn transfer_ownership(caller: Address, contract_id: Address, new_owner: Address) -> Result<(), RegistryError>
fn update_metadata(owner: Address, contract_id: Address, name: String, description: String) -> Result<(), RegistryError>
fn upgrade(admin: Address, new_wasm_hash: BytesN<32>) -> Result<(), RegistryError>
fn withdraw_stake(owner: Address, contract_id: Address) -> Result<I128, RegistryError>
struct ContractEntry { active: Bool, contract_id: Address, description: String, name: String, owner: Address, registered_at: U32 }
struct ContractProfile { entry: ContractEntry, reputation: Reputation }
struct Proposal { action: ProposalAction, approvals: Vec<Address>, executed: Bool, id: U32, proposer: Address, ready_at: U32 }
struct Reputation { slashed_total: I128, stake: I128, verified: Bool, withdraw_locked_until: U32 }
struct SlashRecord { amount: I128, reason: String, slashed_at: U32 }
union Category { DeFi, Nft, Gaming, Identity, Infrastructure, Payments, Oracle, Dao, Other }
union DataKey { Admins, Threshold, ProposalCount, ProposalData(U32), ContractCount, Contract(Address), OwnerContracts(Address), AllContracts, StakeToken, Treasury, Stake(Address), Verified(Address), Slashes(Address), WithdrawLockedUntil(Address), Categories(Address), ByCategory(Category), Admin }
union ProposalAction { Deactivate(Address), Upgrade(BytesN<32>), AddAdmin(Address), RemoveAdmin(Address), ChangeThreshold(U32), ConfigureStaking(Address, Address), SetVerified(Address, Bool), Slash(Address, I128, String) }
