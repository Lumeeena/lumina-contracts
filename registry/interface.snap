fn get_contract_count() -> U32
fn get_contract_profile(contract_id: Address) -> Result<ContractProfile, RegistryError>
fn get_contracts_by_categories(categories: Vec<Category>, offset: U32, limit: U32) -> Result<Vec<ContractEntry>, RegistryError>
fn get_contracts_by_category_after(category: Category, cursor: Option<Address>, limit: U32) -> Vec<ContractEntry>
fn get_contracts_by_owner(owner: Address, offset: U32, limit: U32) -> Vec<ContractEntry>
fn get_contracts_by_owner_after(owner: Address, cursor: Option<Address>, limit: U32) -> Vec<ContractEntry>
