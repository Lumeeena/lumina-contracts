error RegistryError { AlreadyInitialized = 1, Unauthorized = 2, AlreadyRegistered = 3, ContractNotFound = 4, InvalidMetadata = 5, NotOwner = 6, NotInitialized = 7, ProposalNotFound = 8, ThresholdNotMet = 9, TimelockNotElapsed = 10, AlreadyApproved = 11, NotAdmin = 12, InvalidThreshold = 13, AlreadyExecuted = 14, StakingNotConfigured = 15, InvalidAmount = 16, InsufficientStake = 17, StakeLocked = 18, RegistrationActive = 19, NoCategories = 20, StakeNotEmpty = 21, InvalidRateLimit = 22, NotAllowlisted = 23, RegistrationRateLimited = 24, InsufficientFee = 25, InvalidTags = 26, InvalidAttestation = 27, AttestationNotFound = 28, NotManager = 29, TooManyCategories = 30 }
